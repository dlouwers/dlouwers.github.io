direction: down

pools: "One Workload Identity pool per privilege" {
  grid-columns: 2

  k3s: "homelab-k3s\n(cluster ServiceAccount tokens)" {
    a: "investor-buddy KSAs → read images"
    b: "flux-manifests-reader → read artifacts"
  }
  actions: "github-actions" {
    a: "investor-buddy release.yml → write images"
    b: "typst-d2-mcp release.yml on v* → sign with the tap key in KMS"
  }
  oci: "github-flux-oci" {
    a: "flux-artifact.yml on main → write artifacts\n(three repositories)"
  }
  go: "github-go-modules" {
    a: "design system go-module.yml on v* → write module"
    b: "two consumers, and a keyless SA for Dependabot → read"
  }
}

note: "A principalSet spans every provider in its pool,\nso mixing readers and writers in one pool mixes their grants." {
  shape: text
  near: bottom-center
  style.italic: true
}
