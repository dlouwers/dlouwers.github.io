direction: down

node: "A cluster node" {
  pod: "Pod to start\nruns as ServiceAccount \"my-app\""
  kubelet: "kubelet\n(starts containers, pulls images)"
  plugin: "credential provider plugin\n(a small binary next to the kubelet)"
}

google: "Google Cloud" {
  sts: "token exchange\ntrusts tokens signed by this cluster"
  reg: "private registry" {
    shape: cylinder
  }
}

node.pod -> node.kubelet: "1. needs an image from the registry"
node.kubelet -> node.plugin: "2. here is a token that says\n\"this is ServiceAccount my-app\""
node.plugin -> google.sts: "3. swap it"
google.sts -> node.plugin: "4. a registry token, valid for an hour" {
  style.stroke-dash: 3
}
node.kubelet -> google.reg: "5. pull, as my-app"

note: "No pull secret anywhere. A ServiceAccount that Google\nhas not been told to trust gets nothing." {
  shape: text
  near: bottom-center
  style.italic: true
}
