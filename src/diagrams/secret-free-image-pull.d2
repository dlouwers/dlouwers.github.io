shape: sequence_diagram

kubelet: "kubelet\n(on the node)"
plugin: "credential\nprovider plugin"
sts: "cloud token\nexchange"
reg: "cloud\nregistry"

kubelet -> kubelet: "1. pod my-app needs\nan image from the registry"
kubelet -> plugin: "2. credentials please;\nhere is a token for\nServiceAccount my-app"
plugin -> sts: "3. swap this token"
sts -> plugin: "4. registry token, one hour" {
  style.stroke-dash: 3
}
plugin -> kubelet: "5. credentials" {
  style.stroke-dash: 3
}
kubelet -> reg: "6. pull, as my-app"
