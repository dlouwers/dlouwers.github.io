direction: down

node: "k3s node" {
  pod: "Pod\nKSA investor-buddy\n(annotated with the WIF provider)"
  kubelet: "kubelet"
  plugin: "gcp-wif-credential-provider\n(sha256-pinned, attested)"
}

google: "Google Cloud" {
  sts: "STS\npool homelab-k3s\ntrusts the cluster's JWKS"
  gar: "Artifact Registry\neurope-west4-docker.pkg.dev" {
    shape: cylinder
  }
}

node.pod -> node.kubelet: "1. schedule, image\non *-docker.pkg.dev"
node.kubelet -> node.plugin: "2. ServiceAccount token\nfor the pod's KSA"
node.plugin -> google.sts: "3. token exchange"
google.sts -> node.plugin: "4. short-lived GAR token" {
  style.stroke-dash: 3
}
node.kubelet -> google.gar: "5. pull as the pod"

note: "No imagePullSecrets. A KSA outside the attribute condition\nis refused by STS, so the identity does the work." {
  shape: text
  near: bottom-center
  style.italic: true
}
