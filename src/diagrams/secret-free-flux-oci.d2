direction: down

gh: "GitHub" {
  merge: "merge to main"
  wf: "flux-artifact.yml\nsets image tags\nin the artifact"
  merge -> wf
}

google: "Google Cloud" {
  sts: "STS\npool github-flux-oci\nrepository_id + job_workflow_ref"
  gar: "Artifact Registry\nflux-<repo>/manifests:main" {
    shape: cylinder
  }
}

cluster: "k3s cluster" {
  sc: "source-controller\nas KSA flux-manifests-reader"
  kc: "kustomize-controller"
  sc -> kc: "artifact"
}

gh.wf -> google.sts: "GitHub OIDC token"
google.sts -> gh.wf: "push token" {
  style.stroke-dash: 3
}
gh.wf -> google.gar: "flux push artifact"
cluster.sc -> google.sts: "KSA token (pool homelab-k3s)"
cluster.sc -> google.gar: "pull every 1m"

note: "Nothing writes to git. Branch protection stays on,\nand Flux holds no GitHub credential." {
  shape: text
  near: bottom-center
  style.italic: true
}
