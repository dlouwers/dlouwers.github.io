shape: sequence_diagram

ci: "CI workflow\non GitHub"
reg: "cloud\nregistry"
flux: "Flux\nin the cluster"

ci -> reg: "a change was merged:\npush the configuration,\nas the workflow"
flux -> reg: "anything new? (every minute,\nas Flux's ServiceAccount)"
reg -> flux: "the new artifact" {
  style.stroke-dash: 3
}
flux -> flux: "apply it to the cluster"
