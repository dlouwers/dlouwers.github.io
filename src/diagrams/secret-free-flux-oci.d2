direction: down

gh: "GitHub" {
  merge: "a change\nis merged"
  ci: "CI packages the\nconfiguration\nas an artifact"
  merge -> ci
}

reg: "registry\nat the cloud provider" {
  shape: cylinder
}

home: "The home cluster" {
  flux: "Flux"
  apply: "the cluster\nchanges"
  flux -> apply
}

gh.ci -> reg: "push,\nas the workflow"
reg -> home.flux: "Flux pulls it every minute,\nas its own ServiceAccount"

note: "Flux never talks to GitHub,\nso it needs no GitHub credential." {
  shape: text
  near: bottom-center
  style.italic: true
}
