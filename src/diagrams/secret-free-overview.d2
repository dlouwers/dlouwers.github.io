direction: down

ci: "CI workflow\non GitHub"
flux: "Flux\nin the cluster"
pod: "an app pod\nin the cluster"

cloud: "Cloud provider" {
  sts: "token exchange"
  reg: "registry" {
    shape: cylinder
  }
  sts -> reg: "an hour of access" {
    style.stroke-dash: 3
  }
}

ci -> cloud.sts: "signed by GitHub"
flux -> cloud.sts: "signed by\nthe cluster"
pod -> cloud.sts: "signed by\nthe cluster"
