direction: right

gh: "GitHub Actions" {
  ci: "a build workflow"
}

home: "The home cluster" {
  flux: "Flux\n(applies the configuration)"
  pod: "an application pod"
}

google: "Cloud provider" {
  sts: "token exchange\n\"who are you, and do I trust\nwhoever vouches for you?\""
  reg: "registry\n(images and configuration)" {
    shape: cylinder
  }
}

gh.ci -> google.sts: "\"GitHub says I am this workflow\nin this repository\""
home.flux -> google.sts: "\"the cluster says I am\nthis ServiceAccount\""
home.pod -> google.sts: "\"the cluster says I am\nthis ServiceAccount\""
google.sts -> google.reg: "a token that lives\nfor an hour" {
  style.stroke-dash: 3
}

note: "Nobody holds a key. Each side presents a short-lived,\nsigned statement from a system the other already trusts." {
  shape: text
  near: bottom-center
  style.italic: true
}
