---
import '@dlouwers/stormlantern-tokens/css';
import '../styles/site.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Site-relative path of the link-preview image; a post passes its cover. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
}

const {
  title = 'Dirk Louwers',
  description = 'Notes on software, systems, and finance tooling.',
  image = '/img/hero.jpg',
  imageAlt,
  type = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Link previews (Slack, LinkedIn, Mastodon) only accept an absolute URL.
const imageURL = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      // Pre-paint theme bootstrap. Sets [data-theme] before stylesheets load
      // so token CSS resolves to the right values without a flash.
      (() => {
        const stored = localStorage.getItem('sl-theme');
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.setAttribute('data-theme', stored);
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- PNG and ICO first: Slack, and other link-preview fetchers, do not
         render SVG icons and fall back to /favicon.ico. All are the lantern
         mark; the SVGs follow the colour scheme in browsers that use them. -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/brand/lantern-mark.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/brand/lantern-mark-dark.svg" media="(prefers-color-scheme: dark)" />

    <link rel="alternate" type="application/rss+xml" title={title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content="Stormlantern" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <!-- SVG tritone filter, hidden, available globally. Maps luminance to a
         brand-coloured palette via three stops:
           shadows  → tinted-900 #06181a
           midtones → teal-300   #64a5a6
           highlights → orange-300 #ffa055
         Sea / sky / clouds stay cool teal; brightest spots (lantern glow)
         warm to orange so the brand metaphor reads (safety inside, chaos
         outside). For any <img class="duotone-teal">. -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <filter id="sl-duotone-teal" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="
            0.2126 0.7152 0.0722 0 0
            0.2126 0.7152 0.0722 0 0
            0.2126 0.7152 0.0722 0 0
            0      0      0      1 0"/>
          <feComponentTransfer>
            <feFuncR tableValues="0.0235 0.3922 1.0000"/>
            <feFuncG tableValues="0.0941 0.6471 0.6275"/>
            <feFuncB tableValues="0.1020 0.6510 0.3333"/>
          </feComponentTransfer>
        </filter>
      </defs>
    </svg>

    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Registers all sl-* custom elements on the client.
      // Bundled by Astro/Vite; tree-shake by switching to per-component
      // imports later if any page becomes JS-weight-sensitive.
      import '@dlouwers/stormlantern-components';
    </script>
  </body>
</html>
